# Комментарии — только отдельной строкой: docker compose считает «# …» после пустого значения самим значением.

# --- домен и доступ ---
# домен для Caddy (HTTPS); локально — localhost
DOMAIN=tehnoteka.example.ru
# из него строятся ссылки-приглашения
PUBLIC_URL=https://tehnoteka.example.ru
ADMIN_USER=admin
# обязательно задать: с пустым паролем бэкенд не запустится
ADMIN_PASSWORD=

# --- извлечение: demo (правила, без ключей) | yandex | gigachat | mock (тесты) ---
LLM_PROVIDER=demo
MAX_INPUT_TOKENS=100000

# Yandex AI Studio
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_CA_BUNDLE=

# --- ограничения загрузки ---
MAX_FILES=5
MAX_FILE_MB=20
